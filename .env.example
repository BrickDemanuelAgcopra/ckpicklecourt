# ── Copy to .env and fill in ─────────────────────────────────────────────
# Public URL of the site (used in emails and the confirmation page)
SITE_URL=https://ckpicklecourt.com
NEXT_PUBLIC_SITE_URL=https://ckpicklecourt.com
SITE_DOMAIN=ckpicklecourt.com
ACME_EMAIL=you@example.com           # Let's Encrypt notices

# Database (docker-compose builds DATABASE_URL from these)
POSTGRES_DB=ckpickle
POSTGRES_USER=ckpickle
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# For local dev without Docker:
# DATABASE_URL=postgres://ckpickle:password@localhost:5432/ckpickle

# Admin session signing key — 32+ random chars (openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_IDLE_MINUTES=30

# First admin user (seed creates/updates it on every start)
ADMIN_EMAIL=admin@ckpicklecourt.com
ADMIN_PASSWORD=change-me

# Protects /api/cron/expire (the cron container sends it)
CRON_SECRET=change-me-too

# Club details used at first seed only (editable later in Admin > Settings)
# (address, maps link, Facebook, rules, FAQ and rates default to scripts/content.mjs)
SEED_ADDRESS=
SEED_MAPS_URL=
SEED_PHONE=
SEED_EMAIL=
SEED_FACEBOOK=

# Optional: SMTP for confirmation emails (also switch on "Send confirmation emails" in Admin > Settings)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Chateau Katriannah <no-reply@ckpicklecourt.com>

CLUB_TIMEZONE=Asia/Manila
